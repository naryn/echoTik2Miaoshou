[Unit]
Description=MX POP Cross-Border Pricing API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ops
Group=ops
WorkingDirectory=/opt/mx-pop-pricing
Environment=PYTHONUNBUFFERED=1
Environment=DATABASE_URL=sqlite:////var/lib/mx-pop-pricing/echotik.db
ExecStart=/opt/mx-pop-pricing/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
